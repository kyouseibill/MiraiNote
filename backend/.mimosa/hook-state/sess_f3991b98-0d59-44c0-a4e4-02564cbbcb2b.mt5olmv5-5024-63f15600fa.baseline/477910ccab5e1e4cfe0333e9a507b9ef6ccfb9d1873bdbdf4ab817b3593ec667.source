        await _memoService.PatchStatusAsync(userId, id, new PatchMemoStatusRequest
        {
            IsDone = isDone, IsPinned = isPinned, IsArchived = isArchived
        }, ct);
        return $"已成功更新备忘状态（ID={id}）。";
