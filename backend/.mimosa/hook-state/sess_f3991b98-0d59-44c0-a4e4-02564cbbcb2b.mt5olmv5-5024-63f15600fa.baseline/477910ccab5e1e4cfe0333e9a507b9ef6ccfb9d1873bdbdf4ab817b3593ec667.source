                parameters = new
                {
                    type = "object",
                    properties = new
                    {
                        date_from = new { type = "string", description = "起始日期，格式 yyyy-MM-dd" },
                        date_to   = new { type = "string", description = "结束日期，格式 yyyy-MM-dd" },
                        keyword   = new { type = "string", description = "关键词，模糊匹配标题/内容/目的" },
