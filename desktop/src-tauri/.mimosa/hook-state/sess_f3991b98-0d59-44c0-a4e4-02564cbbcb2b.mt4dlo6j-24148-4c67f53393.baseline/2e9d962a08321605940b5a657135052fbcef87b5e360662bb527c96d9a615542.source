[package]
name = "mirai"
version = "0.1.0"
description = "MiraiNote 桌面客户端（Mirai）"
edition = "2021"

# 大版本对齐 Tauri 2；SHELL 流负责插件注册与窗口逻辑
# crate-type 不含 cdylib：桌面端静态链接即可；mingw ld 的导出序号上限（65535）会在
# 链接 mirai_lib.dll 时报 "export ordinal too large"（2026-08-22 实测）。
# 若未来做移动端再加回 "cdylib" 并切换 MSVC 工具链。
[lib]
name = "mirai_lib"
crate-type = ["staticlib", "rlib"]

[build-dependencies]
tauri-build = { version = "2", features = [] }

[dependencies]
tauri = { version = "2", features = ["tray-icon"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
tauri-plugin-global-shortcut = "2"
tauri-plugin-notification = "2"
tauri-plugin-autostart = "2"
tauri-plugin-store = "2"

[profile.release]
codegen-units = 1
lto = true
opt-level = "s"
panic = "abort"
strip = true
